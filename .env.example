# Public client variables (safe to expose in browser builds).
# Configure the same values in local .env and the hosting provider.
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server runtime only. Never prefix secrets with VITE_.
# Required when server-side Supabase calls need a private network URL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Mercado Pago credentials. Never add these to VITE_* variables or Git.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
APP_BASE_URL=
